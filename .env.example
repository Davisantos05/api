# Copie para .env. Não versione segredos ou credenciais reais.
NEXUS_ENV=development
NEXUS_DATABASE_URL=sqlite:///./nexus.db
# Defina um valor longo e aleatório antes da etapa de autenticação.
NEXUS_SECRET_KEY=change-me-in-local-env
# Token provisório da Etapa 2. Use ao menos 32 caracteres aleatórios.
NEXUS_DEV_AGENT_TOKEN=replace-with-a-random-development-token
